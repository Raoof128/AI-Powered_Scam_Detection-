# Application Settings
APP_NAME=scam-detector
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Security
SECRET_KEY=your-secret-key-change-in-production
API_KEY_HEADER=X-API-Key
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database Configuration
DATABASE_URL=postgresql://scamdetector:password@localhost:5432/scamdetector
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=86400

# ML Model Configuration
MODEL_PATH=data/models
DEFAULT_MODEL=ensemble_v1
CONFIDENCE_THRESHOLD=0.75
BATCH_SIZE=32
MAX_SEQUENCE_LENGTH=512

# BERT Configuration
BERT_MODEL=bert-base-uncased
BERT_CACHE_DIR=data/models/bert_cache

# Performance Settings
MAX_WORKERS=4
REQUEST_TIMEOUT=30
MAX_CONTENT_LENGTH=1048576
RATE_LIMIT_PER_MINUTE=100

# Feature Flags
ENABLE_AUSTRALIAN_PATTERNS=true
ENABLE_URL_SCANNING=true
ENABLE_PHONE_VALIDATION=true
ENABLE_METRICS=true

# Monitoring
PROMETHEUS_PORT=9090
ENABLE_PROMETHEUS=false

# Logging
LOG_FORMAT=json
LOG_FILE=logs/scam-detector.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# Australian-specific Settings
AUSTRALIAN_TLD_VALIDATION=true
VALIDATE_ABN=true
VALIDATE_TFN=false
WHITELISTED_DOMAINS=ato.gov.au,myagov.gov.au,australia.gov.au

# Dataset Configuration
DATASET_SIZE=10000
TRAIN_TEST_SPLIT=0.8
RANDOM_SEED=42

# Email Settings (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=admin@example.com
